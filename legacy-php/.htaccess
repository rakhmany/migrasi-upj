# =========================
# HTTP (80) → Redirect ke HTTPS
# =========================
server {
    listen 80;
    server_name upj.ac.id www.upj.ac.id;
    return 301 https://$host$request_uri;
}

# =========================
# HTTPS (443)
# =========================
server {
    listen 443 ssl http2;
    server_name upj.ac.id www.upj.ac.id;

    # --- Sertifikat (sesuaikan) ---
    ssl_certificate     /etc/letsencrypt/live/upj.ac.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/upj.ac.id/privkey.pem;

    # --- Akar dokumen (sesuaikan) ---
    root /var/www/upj/public;
    index index.php index.html;

    # ========== Redirect khusus dari .htaccess ==========
    # /ppar → halaman statis
    location = /ppar {
        return 301 https://upj.ac.id/static-page/226/ppar;
    }

    # (Opsional) Paksa root ke non-www
    location = / {
        if ($host ~* ^www\.upj\.ac\.id$) {
            return 301 https://upj.ac.id$request_uri;
        }
    }

    # ========== Rewrites URL "cantik" → file PHP ==========
    # *Catatan*: gunakan '&' biasa (di .htaccess terlihat &amp; karena HTML-escaped)

    location ~ ^/menu/([0-9]+)/([a-z0-9_-]+)$                  { rewrite ^ /menu.php?id=$1&p=$2 last; }
    location ~ ^/facilities/([0-9]+)/([a-z0-9_-]+)/page/([0-9]+)$ { rewrite ^ /facilities.php?id=$1&p=$2&page=$3 last; }
    location ~ ^/facilities/([0-9]+)/([a-z0-9_-]+)$            { rewrite ^ /facilities.php?id=$1&p=$2 last; }
    location ~ ^/career/page/([0-9]+)$                         { rewrite ^ /career.php?page=$1 last; }
    location ~ ^/vacancy/([0-9]+)/([a-z0-9_-]+)$               { rewrite ^ /vacancy.php?id=$1&p=$2 last; }

    location ~ ^/highlights/page/([0-9]+)$                     { rewrite ^ /highlights.php?page=$1 last; }
    location ~ ^/highlight/([0-9]+)/([a-z0-9_-]+)$             { rewrite ^ /highlight-detail.php?id=$1&p=$2 last; }
    location ~ ^/news/page/([0-9]+)$                           { rewrite ^ /news.php?page=$1 last; }
    location ~ ^/news/([0-9]+)/([a-z0-9_-]+)$                  { rewrite ^ /news-detail.php?id=$1&p=$2 last; }
    location ~ ^/events/page/([0-9]+)$                         { rewrite ^ /events.php?page=$1 last; }
    location ~ ^/events/([0-9]+)/([a-z0-9_-]+)$                { rewrite ^ /upcoming-event-detail.php?id=$1&p=$2 last; }
    location ~ ^/alumni/([0-9]+)/([a-z0-9_-]+)$                { rewrite ^ /pj-community-alumni-detail.php?id=$1&p=$2 last; }
    location ~ ^/hall-of-fame/page/([0-9]+)$                   { rewrite ^ /hall-of-fame.php?page=$1 last; }

    location ~ ^/press-release/page/([0-9]+)$                  { rewrite ^ /press-release.php?page=$1 last; }
    location ~ ^/press-release/([0-9]+)/([a-z0-9_-]+)$         { rewrite ^ /press-release-detail.php?id=$1&p=$2 last; }

    location ~ ^/static-page/([0-9]+)/([a-z0-9_-]+)/mode=true$ { rewrite ^ /static-page2.php?id=$1&p=$2 last; }
    location ~ ^/static-page/([0-9]+)/([a-z0-9_-]+)$           { rewrite ^ /static-page.php?id=$1&p=$2 last; }

    location ~ ^/news/tag/([0-9]+)/([a-z0-9_-]+)$              { rewrite ^ /news-tag.php?id=$1&p=$2 last; }
    location ~ ^/events/tag/([0-9]+)/([a-z0-9_-]+)$            { rewrite ^ /events-tag.php?id=$1&p=$2 last; }
    location ~ ^/statis/tag/([0-9]+)/([a-z0-9_-]+)$            { rewrite ^ /statis-tag.php?id=$1&p=$2 last; }

    # ========== Fallback: kalau ada file.php meski URL tanpa .php ==========
    # Padanan:
    #   RewriteCond %{REQUEST_FILENAME} !-f
    #   RewriteCond %{REQUEST_FILENAME}.php -f
    #   RewriteRule ^(.*)$ $1.php [NC,L]
    location / {
        try_files $uri $uri/ @try_php_extension;
    }
    location @try_php_extension {
        rewrite ^/(.*)$ /$1.php last;
    }

    # ========== Front controller (index.php) untuk rute lain ==========
    # Padanan:
    #   RewriteCond %{REQUEST_FILENAME} !-l
    #   RewriteCond %{REQUEST_FILENAME} !-f
    #   RewriteCond %{REQUEST_FILENAME} !-d
    #   RewriteRule . /index.php [L]
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ========== PHP-FPM ==========
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;   # SESUAIKAN
        fastcgi_read_timeout 120s;
    }

    # ========== Keamanan ringkas ==========
    location ~ /\.ht { deny all; }

    # ========== Header/CORS dari .htaccess ==========
    add_header Access-Control-Allow-Origin "https://www.arsitektur.upj.ac.id" always;

    # ========== Kompresi & Cache statik ==========
    gzip on;
    gzip_types text/plain text/css application/javascript application/json application/xml;
    gzip_min_length 1024;

    location ~* \.(css|js|jpg|jpeg|png|gif|svg|webp|ico|woff2?)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }
    # Contoh khusus (setara .htaccess)
    location ~* \.(jpg|jpeg)$ { expires 1y; add_header Cache-Control "public, max-age=31536000"; }
    location ~* \.css$       { expires 1M; add_header Cache-Control "public, max-age=2592000";  }
}