<?php
include('front.config.inc.php'); 

if(isset($_POST) && sizeof($_POST) > 0 )
{
	$success_insert = false;
	
	$pmbname = trim($_POST['pmbname']);
	$pmbnik = trim($_POST['pmbnik']);
	$pmbjkel = trim($_POST['pmbjkel']);
	$pmbbirth = trim($_POST['pmbbirth']);
	$pmbplace = trim($_POST['pmbplace']);
	$pmbagama = trim($_POST['pmbagama']);
	$pmbstatusnikah = trim($_POST['pmbstatusnikah']);
	$pmbaddress = trim($_POST['pmbaddress']);
	$pmbhp = trim($_POST['pmbhp']);
	$pmbemail = trim($_POST['pmbemail']);
	$pmbphoto = trim($_POST['pmbphoto']);
	$pmblulusan = trim($_POST['pmblulusan']);
	$pmbgraduateyear = trim($_POST['pmbgraduateyear']);
	$pmbdadyname = trim($_POST['pmbdadyname']);
	$pmbparentaddress = trim($_POST['pmbparentaddress']);
	$pmbparenthp = trim($_POST['pmbparenthp']);
	$pmbdadylaststudy = trim($_POST['pmbdadylaststudy']);
	$pmbdadyjob = trim($_POST['pmbdadyjob']);
	$pmbknowwe = trim($_POST['pmbknowwe']);
	$pmbacademicscore = trim($_POST['pmbacademicscore']);
	$pmbenglishscore = trim($_POST['pmbenglishscore']);
	$status = trim($_POST['status']);
	$ip = trim($_SERVER['REMOTE_ADDR']); 
	
	$err_msg = '';
	
	if ($pmbname == '') { $err_msg .= 'Name must be filled<br />';/* //$lang['pmb']['error']['nama_kosong']; */ }
    elseif (!ereg("^[[:alpha:]]([[:alpha:]]|[[:space:]]|[.]+)+$",$pmbname)) { $err_msg .= 'Name tidak valid';/* //$lang['pmb']['error']['nama_invalid'];  */}
    if ($pmbnik == '') { $err_msg .= 'NIK must be filled<br />';/* //$lang['pmb']['error']['nik']; */ }
    if ($pmbplace == '') { $err_msg .= 'Place of Birth must be filled<br />'; }
    if ($pmbbirth == '') { $err_msg .= 'Date of Birth must be filled<br />';/* //$lang['pmb']['error']['tanggal_lahir']; */ }
    if ($pmbjkel == '') { $err_msg .= 'Jenis kelamin must be filled<br />';/* //$lang['pmb']['error']['jenis_kelamin']; */ }
    if ($pmbagama == '') { $err_msg .= 'Religian must be filled<br />';/* //$lang['pmb']['error']['agama']; */ }
    if ($pmbstatusnikah == '') { $err_msg .= 'Status Pernikahan harus dipilih<br />';/* //"Semua isian must be filled"; */ }
    if ($pmbaddress == '') { $err_msg .= 'Address must be filled<br />';/* $lang['pmb']['error']['alamat']; */ }
    /*if ($pmbpostcode == '') { $error['pmbpostcode'] = 'Kode pos must be filled<br />';}*/ /* $lang['pmb']['error']['kodepos']; */
    /*if ($input_telp == '') { $msg .= $lang['pmb']['error']['telp']; }*/
    if ($pmbhp == '') { $err_msg .=  'No Handphone must be filled<br />';/* $lang['pmb']['error']['hp']; */ }
    if ($pmbemail == '') { $err_msg .= 'Email must be filled<br />';/* $lang['pmb']['error']['email']; */ }
    elseif ( !filter_var($pmbemail, FILTER_VALIDATE_EMAIL) ) { $err_msg .= 'Email tidak valid<br />';/* $msg .= $lang['pmb']['error']['email_invalid']; */ }
    if ($pmbacademicscore == '') { $err_msg .= "Average Academic Score must be filled<br />"; }
    if ($pmbenglishscore == '') { $err_msg .= "Average English Score must be filled<br />"; }
    if ($pmbknowwe == '') { $err_msg .= "Sumber Informasi harus dipilih<br />"; }
    if ($pmblulusan == '') { $err_msg .= 'High School Name must be filled<br />';/* $lang['pmb']['error']['tahun_lulus']; */ }
	
    $data_pmbphoto 				= $_FILES["data_pmbphoto"];
	$old_pmbphotoname 			= trim($_POST["old_pmbphotoname"]);
	if ($data_pmbphoto['name'] == "" && $old_pmbphotoname == ""  ) { $msg.="Silakan unggah file CV<br>";}
	
	if( isset($data_pmbphoto["name"]) && $data_pmbphoto['name'] !='')
	{
	   	$handle                     = new Upload($data_pmbphoto);
	    $handle->allowed            = array('application/pdf', 'image/jpeg', 'image/png'); 
	    if ($handle->uploaded) { 
	        $handle->Process("./upload/module/pmb/");
	        if ($handle->processed) {
	            
	            $pmbphotoname     = $handle->file_dst_name;
	            
	            
	        } else {
	            
	            $msg .= 'TOEFL or IELTS : '.$handle->error;
	            $handle->clean();
	        } 
	        $handle->clean();
	    } else { 
	        $msg .= 'TOEFL or IELTS : '.$handle->error;
	    }
	}else
	{
	  $pmbphotoname = isset($old_pmbphotoname) ? $old_pmbphotoname : '';
	}
	if (!( $_SESSION['security_code'] == $_POST['security_code'] && !empty($_SESSION['security_code'] ) )) {
		$err_msg .=  "Invalid capthca<br>";
	} 
							      
    if(empty($err_msg))
    { 
	    $sql = 'INSERT INTO rgs SET 
		pmbname= '.$db->qstr($pmbname).',
		pmbnik= '.$db->qstr($pmbnik).',
		pmbjkel= '.$db->qstr($pmbjkel).',
		pmbbirth= '.$db->qstr($pmbbirth).',
		pmbplace= '.$db->qstr($pmbplace).',
		pmbagama= '.$db->qstr($pmbagama).',
		pmbstatusnikah= '.$db->qstr($pmbstatusnikah).',
		pmbaddress= '.$db->qstr($pmbaddress).',
		pmbhp= '.$db->qstr($pmbhp).',
		pmbemail= '.$db->qstr($pmbemail).',
		pmbphoto= '.$db->qstr($pmbphotoname).',
		pmblulusan= '.$db->qstr($pmblulusan).',
		pmbgraduateyear= '.$db->qstr($pmbgraduateyear).',
		pmbdadyname= '.$db->qstr($pmbdadyname).',
		pmbparentaddress= '.$db->qstr($pmbparentaddress).',
		pmbparenthp= '.$db->qstr($pmbparenthp).',
		pmbdadylaststudy= '.$db->qstr($pmbdadylaststudy).',
		pmbdadyjob= '.$db->qstr($pmbdadyjob).',
		pmbknowwe= '.$db->qstr($pmbknowwe).',
		pmbacademicscore= '.$db->qstr($pmbacademicscore).',
		pmbenglishscore= '.$db->qstr($pmbenglishscore).',
		status= '.$db->qstr('Mendaftar').',
		ip= '.$db->qstr($ip).' 
		';
		if($db->Execute($sql))
		{
			$success_insert = true;
		}
		else
		{
			echo $sql;
		}
		
		

    }
     
}


